@startuml
skinparam packageStyle rectangle
skinparam componentStyle rectangle
skinparam defaultFontName "Roboto"

' === Data Layer ===
database "MySQL DB" as DB

' === ETL & Feature Engineering ===
package "ETL / Feature Engineering" {
  component "script.py" as ETL0
  component "00_revisit_data_prepare.py" as ETL00
  component "01_prepare_data.py" as ETL01
  component "02_gewogen_storing.py"  as ETL02
  component "03_weerinfo.py" as ETL03
  component "04_aantal_breuken.py" as ETL04
  component "05_fe.py"            as ETL05
}

' === Modelling ===
package "Modelling" {
  component "98_logreg.py" as ML98
  component "99_xgb.py"    as ML99
  component "06_voorspellingen.py" as PRED
  file "models/ model_*.json" as Models
}

' === Dashboard & Monitoring ===
package "Dashboard / Monitoring" {
  component "dashboard/app.py" as Dash
  component "check_calibratie_3m.py" as Calib
}

' === Containerisation ===
node "docker-compose.yml\nservice: db (MySQL)" as DockDB
node "docker-compose.yml\nservice: dashboard (Streamlit)" as DockDash

' === Flows ===
ETL0 --> DB : load CSV files\npipes_original\nbreaks_original
ETL00 ..> DB : reads weighted_snapshots_v3\nmerges breakages
ETL01 --> DB : snapshots_part1
ETL02 --> DB : snapshots_part2
ETL03 --> DB : weather_info &\nsnapshots_part3
ETL04 --> DB : snapshots_part4
ETL05 --> DB : snapshots_part5\ntrain/predict splits

ML99 ..> DB : reads snapshots_traintest
ML99 --> Models : save Booster
ML99 --> DB : write model_experiments log
ML98 ..> DB : reads snapshots

PRED ..> DB : reads snapshots_predict
PRED ..> Models : load model.pkl
PRED --> DB : predictions_new

Dash ..> Models : load latest model
Dash ..> DB : interactive queries\n(show predictions & metadata)
Calib ..> DB : read predictions & breaks_original

DB --> DockDB : persisted in container
Dash --> DockDash

@enduml
